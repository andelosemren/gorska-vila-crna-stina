# --- ATRAKCIJE I RESET LOZINKE ---
msgid "Istražite okolicu"
msgstr "Explore the surroundings"

msgid "Livno i okolica nude nezaboravne avanture. Otkrijte ljepote koje vas okružuju."
msgstr "Livno and its surroundings offer unforgettable adventures. Discover the beauty around you."

msgid "Divlji konji na Kruzima"
msgstr "Wild Horses on Kruzi"

msgid "Doživite susret s preko 800 divljih konja koji slobodno lutaju nepreglednim prostranstvima planine Cincar."
msgstr "Experience an encounter with over 800 wild horses roaming freely across the vast expanses of Mount Cincar."

msgid "Buško jezero"
msgstr "Busko Lake"

msgid "Jedno od najvećih umjetnih jezera u Europi, idealno za kupanje, ribolov i opuštajuće šetnje."
msgstr "One of the largest artificial lakes in Europe, ideal for swimming, fishing, and relaxing walks."

msgid "Planinarenje i priroda"
msgstr "Hiking and Nature"

msgid "Otkrijte skrivene staze, uživajte u pogledu s planinskih vrhova i udahnite čisti zrak."
msgstr "Discover hidden trails, enjoy the view from mountain peaks, and breathe in the fresh air."

msgid "Zaboravili ste lozinku?"
msgstr "Forgot your password?"

msgid "Reset lozinke"
msgstr "Password Reset"

msgid "Unesite svoju email adresu i poslat ćemo vam upute."
msgstr "Enter your email address and we will send you instructions."

msgid "POŠALJI EMAIL"
msgstr "SEND EMAIL"

msgid "Email je poslan!"
msgstr "Email sent!"

msgid "Provjerite svoj inbox (i Spam mapu). Poslali smo vam link za resetiranje."
msgstr "Check your inbox (and Spam folder). We have sent you a reset link."

msgid "Nova lozinka"
msgstr "New Password"

msgid "Uspješno!"
msgstr "Success!"

msgid "Lozinka je promijenjena. Sada se možete prijaviti."
msgstr "Password changed. You can now log in."

# --- RECENZIJE GOSTIJU ---
msgid "Riječ naših gostiju"
msgstr "What Our Guests Say"

msgid "Nevjerojatno iskustvo! Vila uživo izgleda još bolje nego na slikama. Mir, tišina i beskompromisni luksuz."
msgstr "An incredible experience! The villa looks even better in person than in the pictures. Peace, quiet, and uncompromising luxury."

